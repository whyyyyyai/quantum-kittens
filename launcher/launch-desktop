#!/bin/sh
# launch-desktop: open the command deck's desktop at login. No AI.
#
# READ THIS FIRST
#   This is a plain shell script. It makes no AI or API calls and starts no
#   agent turn. It only opens windows and starts services that are not
#   already running, so it costs nothing to run, and running it twice opens
#   nothing new.
#
#   What it opens is listed in a config file, one window per line:
#       ~/.config/quantum-kittens/launch.conf
#   If that file is missing, the copy next to this script is used
#   (launch.conf.example). Edit the list to add or remove a seat. A seat
#   that is paused or out of usage should be commented out there. This
#   script cannot tell whether an agent is spent.
#
#   Order: start the user services, open each window in the list, then run
#   scratchpad-layout once (if it is installed) so the windows land in
#   their places.
#
#   launch-desktop             open whatever is missing
#   launch-desktop --dry-run   print what it would do, change nothing
#   launch-desktop install     start it at every login (picks the right way
#                              for this system: systemd, XDG autostart, or
#                              a macOS LaunchAgent)
#   launch-desktop uninstall   remove that login entry
#
# Written by: Claude (2026-11-25). Reviewed by: Grok (PR #2).

set -u
HERE=$(cd "$(dirname "$0")" && pwd)
CONF_DIR=${XDG_CONFIG_HOME:-$HOME/.config}/quantum-kittens
CONF=$CONF_DIR/launch.conf
[ -f "$CONF" ] || CONF=$HERE/launch.conf.example
DRY=0
OS=$(uname -s)

# say: one line to stdout, so the journal or a terminal shows what happened.
say() { printf 'launch-desktop: %s\n' "$*"; }

# have: true if a program is on PATH.
have() { command -v "$1" >/dev/null 2>&1; }

# agent_bins: at login this runs under the systemd user environment, whose
# PATH is short: an agent installed into its own bin dir (grok lives in
# ~/.grok/bin) is invisible to `have`, so its window was skipped every
# login (the 2026-11-25 outage report). Add the bin dirs that exist; the
# user's own PATH and environment are untouched.
agent_bins() {
    for dir in "$HOME/.local/bin" "$HOME/.grok/bin" "$HOME/bin" "$HOME/.cargo/bin"; do
        [ -d "$dir" ] || continue
        case ":$PATH:" in *":$dir:"*) ;; *) PATH="$PATH:$dir" ;; esac
    done
}

# run: do it, or print it under --dry-run.
run() {
    if [ "$DRY" = 1 ]; then say "would run: $*"; else "$@"; fi
}

# spawn: start a long-lived program detached from this script, so that it
# keeps running after the script exits (and after a systemd unit that ran
# this script finishes). On systemd it gets its own scope.
spawn() {
    if [ "$DRY" = 1 ]; then say "would open: $*"; return; fi
    if have systemd-run && systemctl --user show-environment >/dev/null 2>&1; then
        setsid systemd-run --user --scope --quiet -- "$@" >/dev/null 2>&1 < /dev/null &
    else
        setsid "$@" >/dev/null 2>&1 < /dev/null &
    fi
}

# in_terminal: true if a process named $1 is running inside a terminal
# window. On Linux it walks /proc up from each match, so a background copy
# of the same program (for example a daemon) does not count. Elsewhere it
# falls back to "a process with that name exists".
in_terminal() {
    if [ ! -d /proc/1 ]; then pgrep -x "$1" >/dev/null 2>&1; return; fi
    for pid in $(pgrep -x "$1" 2>/dev/null); do
        p=$pid
        while [ "$p" -gt 1 ] 2>/dev/null; do
            p=$(awk '{print $4}' "/proc/$p/stat" 2>/dev/null) || break
            [ -n "$p" ] || break
            case $(cat "/proc/$p/comm" 2>/dev/null) in
                kitty|foot|alacritty|wezterm-gui|gnome-terminal-|konsole|xterm|Terminal) return 0 ;;
            esac
        done
    done
    return 1
}

# terminal: the command that opens a new terminal window running "$@" and
# keeps it open after the program exits, so an error stays readable.
terminal() {
    if have kitty; then spawn kitty --directory "$HOME" --hold "$@"
    elif have foot; then spawn foot --working-directory="$HOME" --hold "$@"
    elif have alacritty; then spawn alacritty --working-directory "$HOME" --hold -e "$@"
    elif have wezterm; then spawn wezterm start --cwd "$HOME" -- "$@"
    elif have gnome-terminal; then spawn gnome-terminal --working-directory="$HOME" -- "$@"
    elif [ "$OS" = Darwin ]; then
        run osascript -e "tell application \"Terminal\" to do script \"cd ~; $*\""
    elif have x-terminal-emulator; then spawn x-terminal-emulator -e "$@"
    else say "no terminal found; skipped: $*"
    fi
}

# start_services: start the deck's user services that are installed. It
# starts them; enabling them at boot is a separate choice made at setup.
start_services() {
    have systemctl || return 0
    systemctl --user show-environment >/dev/null 2>&1 || return 0
    for unit in comms-deck.service push-courier.service scratchpad-keeper.service; do
        if systemctl --user cat "$unit" >/dev/null 2>&1; then
            systemctl --user is-active --quiet "$unit" && continue
            run systemctl --user start "$unit"
        fi
    done
}

# open_windows: read the config and open each window that is not already
# open. Line format:  name  check  command...
#   check is the process name to look for; "-" means the command itself
#   refuses to open a second copy.
#   A command starting with @ is an app, opened directly; anything else
#   runs in a new terminal window.
open_windows() {
    opened=0
    while read -r name check cmd; do
        case $name in ''|'#'*) continue ;; esac
        [ -n "$cmd" ] || { say "$name: no command in $CONF"; continue; }
        app=0
        case $cmd in @*) app=1; cmd=${cmd#@} ;; esac
        set -- $cmd
        have "$1" || { say "$name: $1 is not installed, skipped"; continue; }
        if [ "$check" != - ]; then
            if [ "$app" = 1 ]; then pgrep -x "$check" >/dev/null 2>&1 && continue
            else in_terminal "$check" && continue
            fi
        fi
        if [ "$check" = - ]; then
            # It checks for itself, so it may open nothing: not counted.
            [ "$app" = 1 ] && spawn "$@" || terminal "$@"
            continue
        fi
        say "$name: opening"
        if [ "$app" = 1 ]; then spawn "$@"; else terminal "$@"; fi
        opened=$((opened + 1))
    done < "$CONF"
}

# arrange: give new windows a moment to appear, then snap them into place.
arrange() {
    have scratchpad-layout || return 0
    [ "$opened" -gt 0 ] || { say "nothing new opened; layout left as it is"; return 0; }
    [ "$DRY" = 1 ] || sleep 6
    run scratchpad-layout
}

# install: start this script at every login, the way this system does it.
install() {
    self=$HERE/launch-desktop
    mkdir -p "$CONF_DIR"
    [ -f "$CONF_DIR/launch.conf" ] || cp "$HERE/launch.conf.example" "$CONF_DIR/launch.conf"
    if [ "$OS" = Darwin ]; then
        dest=$HOME/Library/LaunchAgents/quantum-kittens.launch.plist
        mkdir -p "${dest%/*}"
        sed "s|@LAUNCHER@|$self|" "$HERE/quantum-kittens.launch.plist" > "$dest"
        launchctl load -w "$dest"
        say "installed $dest"
    elif have systemctl && systemctl --user show-environment >/dev/null 2>&1; then
        dest=${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/quantum-kittens-launch.service
        mkdir -p "${dest%/*}"
        sed "s|@LAUNCHER@|$self|" "$HERE/quantum-kittens-launch.service" > "$dest"
        systemctl --user daemon-reload
        systemctl --user enable quantum-kittens-launch.service
        say "installed $dest (runs at the next login; 'launch-desktop' runs it now)"
    else
        dest=${XDG_CONFIG_HOME:-$HOME/.config}/autostart/quantum-kittens-launch.desktop
        mkdir -p "${dest%/*}"
        sed "s|@LAUNCHER@|$self|" "$HERE/quantum-kittens-launch.desktop" > "$dest"
        say "installed $dest"
    fi
    say "the list of windows is $CONF_DIR/launch.conf"
}

# uninstall: remove whichever login entry install wrote. The config stays.
uninstall() {
    if [ "$OS" = Darwin ]; then
        f=$HOME/Library/LaunchAgents/quantum-kittens.launch.plist
        [ -f "$f" ] && launchctl unload -w "$f" && rm -f "$f"
    fi
    if have systemctl; then
        systemctl --user disable quantum-kittens-launch.service 2>/dev/null
        rm -f "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/quantum-kittens-launch.service"
        systemctl --user daemon-reload 2>/dev/null
    fi
    rm -f "${XDG_CONFIG_HOME:-$HOME/.config}/autostart/quantum-kittens-launch.desktop"
    say "login entry removed; $CONF_DIR/launch.conf kept"
}

case ${1:-} in
    install) install; exit ;;
    uninstall) uninstall; exit ;;
    --dry-run) DRY=1 ;;
    '') ;;
    *) sed -n '2,27p' "$0"; exit 2 ;;
esac

say "using $CONF"
start_services
agent_bins
open_windows
arrange
say "done"
